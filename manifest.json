  "Список не исчезает, если вы отдыхаете — он просто ждёт.",
  "Маленький шаг тоже считается.",
  "Не спешить — это тоже способ двигаться вперёд.",
  "То, что не сделано сегодня, не исчезло — оно просто подождёт до момента, когда будут силы.",
  "Порядок — это не про идеально, а про честно.",
  "Иногда лучшее дело на сегодня — просто отдохнуть.",
  "Вы не обязаны быть продуктивны каждую минуту.",
  "Прогресс тише, чем кажется — но он есть.",
  "Хватит на сегодня — нормальная и достаточная мера.",
  "Забота о себе тоже входит в список дел.",
  "Не всё горит. Многое может подождать до завтра.",
  "Тишина в списке дел — тоже результат.",
  "Иногда самое важное дело — просто заметить, что уже сделано.",
  "Вы двигаетесь в своём темпе, и этого достаточно.",
  "Не каждый день должен быть продуктивным, чтобы быть хорошим.",
  "Маленькие дела складываются в большие перемены — незаметно, но верно.",
  "Отдых — не пауза в жизни, а её часть.",
  "Сегодня можно сделать меньше. Это не откат назад."
];
function dayOfYear(){ const now = new Date(); const start = new Date(now.getFullYear(), 0, 0); return Math.floor((now-start)/86400000); }
function renderCalmCard(){ document.getElementById('calmText').textContent = calmPhrases[dayOfYear() % calmPhrases.length]; }

// ---------- profile / greeting ----------
function applyGreeting(name){
  const subtitle = document.getElementById('heroSubtitle');
  if(name){
    subtitle.textContent = 'Привет, '+name+' — расскажи, что нужно сделать сегодня';
  } else {
    subtitle.innerHTML = `Расскажи, что нужно сделать — остальное само разберётся · <span id="nameLink" style="text-decoration:underline; cursor:pointer; color:var(--moss-deep);">сказать, как вас зовут?</span>`;
    const link = document.getElementById('nameLink');
    if(link) link.addEventListener('click', ()=>{ document.querySelector('.tab[data-tab="profile"]').click(); });
  }
}
async function initGreeting(){
  try{ const me = await api('/api/me'); applyGreeting(me.name); }
  catch(e){ applyGreeting(null); }
}
async function loadProfileName(){
  try{ const me = await api('/api/me'); document.getElementById('profileNameInput').value = me.name || ''; }
  catch(e){}
}
document.getElementById('profileNameSaveBtn').addEventListener('click', async ()=>{
  const input = document.getElementById('profileNameInput');
  const status = document.getElementById('profileNameStatus');
  const name = input.value.trim();
  if(!name){ status.textContent = 'Введите имя.'; return; }
  try{
    await api('/api/me', { method:'PUT', body: JSON.stringify({name}) });
    applyGreeting(name);
    status.textContent = 'Сохранено.';
  }catch(e){
    status.textContent = 'Не получилось сохранить.';
  }
});
document.getElementById('logoutBtn').addEventListener('click', logout);

// ---------- init ----------
if(token){ startApp(); } else { document.getElementById('authScreen').style.display = 'block'; }

// ---------- PWA service worker ----------
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('/service-worker.js').catch(()=>{});
  });
}
</script>
